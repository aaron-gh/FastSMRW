<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push notifications (Android 13+ asks the user; older versions grant it). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Run in the background (Settings, Background): a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />


    <application
        android:name=".FastSmApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FastSMRW">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Mastodon OAuth redirect (registered as redirect_uri=fastsm://oauth). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fastsm" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Receives the relay's data-only pushes from Firebase and shows them.
             Android starts the process for this even when the app is closed. -->
        <service
            android:name=".push.FastSmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Keeps FastSMRW running after its window closes (Settings, Background). -->
        <service
            android:name=".background.BackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a social media client's live timelines and sounds running for blind users while the app is closed." />
        </service>

        <!-- Runs a push notification's Reply, Favourite or Boost button. -->
        <receiver
            android:name=".push.PushActionReceiver"
            android:exported="false" />
    </application>
</manifest>
